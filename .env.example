# Genie — every environment key, with the feature it powers.
# Copy to .env.local and fill what you need; src/lib/env.ts is the source of this list.

# REQUIRED — Genie's database
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED — sign-in
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED — every server-side read and write
SUPABASE_SERVICE_ROLE_KEY=

# optional — the owner account (defaults to raghu@nandan.co.in)
RAGHU_EMAIL=

# optional — everything Genie writes with Claude
ANTHROPIC_API_KEY=

# optional — the CRM's own database
CRM_SUPABASE_URL=

# optional — the CRM's own database
CRM_SUPABASE_SERVICE_KEY=

# optional — the nine Vercel crons
CRON_SECRET=

# optional — outbound mail that is not Gmail
RESEND_API_KEY=

# optional — IMS expiry mail's From address
IMS_MAIL_FROM=

# optional — Connect Gmail
GOOGLE_OAUTH_CLIENT_ID=

# optional — Connect Gmail
GOOGLE_OAUTH_CLIENT_SECRET=

# optional — Drive filing (service account)
GOOGLE_SA_EMAIL=

# optional — Drive filing (service account)
GOOGLE_SA_PRIVATE_KEY=

# optional — Drive filing — the upload folder
DRIVE_UPLOAD_FOLDER_ID=

# optional — Drive filing — the mail root
DRIVE_MAIL_ROOT=

# optional — absolute links in mail (defaults to genie.nandan.co.in)
NEXT_PUBLIC_SITE_URL=

# optional — server-side transcription of voice notes
OPENAI_API_KEY=

# optional — PDF pressing on a laptop (Vercel ships its own Chromium)
CHROME_PATH=
