# ---- Supabase (company-email-owned project) ----
# Copy to .env.local and fill in. NEVER commit .env.local (see .gitignore).

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — service role key. NEVER prefix with NEXT_PUBLIC_.
# Used by /api/upload, admin user management, and the seed/acceptance scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single identity allowed to edit Management Target Date (spec §0.5).
RAGHU_EMAIL=raghu@nandan.co.in

# Server-only — Claude. Powers Eva research, AI deal scoring, and the Genie
# Hint panel on every Job Plan. Without it those three features return a clear
# "missing key" message and everything else works normally.
ANTHROPIC_API_KEY=sk-ant-...

# ---- IMS (the Integrated Management System's OWN Supabase project) ----
# A SEPARATE fork, exactly as the CRM is. Server-only; never NEXT_PUBLIC_.
# Without these two, /ims opens and says precisely which step is missing.
IMS_SUPABASE_URL=https://YOUR-IMS-PROJECT.supabase.co
IMS_SUPABASE_SERVICE_KEY=your-ims-service-role-key

# Who the IMS's expiry alerts appear to come from. Defaults to ims@nandan.co.in.
IMS_MAIL_FROM=ims@nandan.co.in
